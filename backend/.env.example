# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
BACKEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

# ─── Demo wallet — one address + one key for gov, escrow, and agent ───────────
# Create at https://wallet.interledger-test.dev/spaza-shop (or your handle)
# SPAZA.key must be the PRIVATE key file (-----BEGIN PRIVATE KEY-----), NOT the public key.
# Run: npm run generate-key --workspace=backend  → upload SPAZA.public.pem to the wallet.
SPAZA_WALLET=https://ilp.interledger-test.dev/spaza-shop
SPAZA_KEY_ID=your-key-id-from-wallet
SPAZA_KEY_PATH=./SPAZA.key

# Optional overrides (defaults to SPAZA_WALLET for all three roles)
# GOV_WALLET=https://ilp.interledger-test.dev/spaza-shop
# ESCROW_WALLET=https://ilp.interledger-test.dev/spaza-shop

DB_PATH=./openremit.db
JWT_SECRET=changeme

# Africa's Talking — leave blank to log SMS/voice to console during dev
# AT_USERNAME=sandbox
# AT_API_KEY=your_api_key
# AT_SENDER_ID=UbuntuPay
# AT_VOICE_FROM=+2549284789292
# AT_TEST_PHONE=+27660987666
AGENT_SHOP_NAME=Joe's Spaza
